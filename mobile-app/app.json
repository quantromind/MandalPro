{
  "expo": {
    "name": "Apla Mandal",
    "slug": "mandalpro",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F8F6"
    },
    "android": {
      "package": "com.mandalpro.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#F8F8F6"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.mandalpro.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Apla Mandal needs access to your photos to upload your Mandal logo.",
        "NSCameraUsageDescription": "Apla Mandal needs camera access to capture your Mandal logo."
      }
    },
    "extra": {
      "eas": {
        "projectId": "47f1988d-9fd0-4c06-961b-8f7a89c9698e"
      }
    }
  }
}

